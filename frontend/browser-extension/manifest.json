{
  "manifest_version": 3,
  "name": "CarVision AI",
  "version": "1.0.0",
  "description": "Sahibinden araç ilanlarını tek tıkla CarVision AI'a aktarır ve detaylı analiz oluşturur.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.sahibinden.com/*",
    "https://*.sahibinden.com/*",
    "https://carvision-ai-delta.vercel.app/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CarVision AI",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.sahibinden.com/*",
        "https://*.sahibinden.com/*"
      ],
      "js": [
        "content.js",
        "comparableExtractor.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}